{
  "editable": true,
  "schemaVersion": 41,
  "refresh": "5s",
  "time": {
    "from": "now-3h",
    "to": "now"
  },
  "title": "Intel XPUMD",
  "uid": "intel-xpumd",
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "Datasource",
        "type": "datasource",
        "query": "prometheus",
        "refresh": 1,
        "current": {}
      },
      {
        "name": "host",
        "label": "Host",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "definition": "label_values(hw_gpu_info, instance)",
        "query": "label_values(hw_gpu_info, instance)",
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "refresh": 2,
        "current": {
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "GPU utilization",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "interval": "5s",
      "gridPos": {"h": 8, "w": 8, "x": 0, "y": 0},
      "fieldConfig": {
        "defaults": {"unit": "percentunit"},
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "interval": "5s",
          "expr": "avg by (pci_bdf, com_intel_subdevice_id) (hw_gpu_utilization_ratio{instance=~\"$host\"})",
          "legendFormat": "{{pci_bdf}}/{{com_intel_subdevice_id}}"
        }
      ]
    },
    {
      "id": 2,
      "title": "GPU frequency",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "interval": "5s",
      "gridPos": {"h": 8, "w": 8, "x": 8, "y": 0},
      "fieldConfig": {
        "defaults": {"unit": "hertz"},
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "interval": "5s",
          "expr": "hw_frequency_hertz{aggregation=\"avg\", instance=~\"$host\"}",
          "legendFormat": "{{pci_bdf}}/{{com_intel_subdevice_id}}: {{hw_frequency_domain}}"
        }
      ]
    },
    {
      "id": 3,
      "title": "GPU temperature",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "interval": "5s",
      "gridPos": {"h": 8, "w": 8, "x": 16, "y": 0},
      "fieldConfig": {
        "defaults": {"unit": "celsius"},
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "interval": "5s",
          "expr": "hw_temperature_celsius{statistic=\"max\", hw_sensor_location=\"gpu\", instance=~\"$host\"}",
          "legendFormat": "{{pci_bdf}}/{{com_intel_subdevice_id}}"
        }
      ]
    },
    {
      "id": 4,
      "title": "Memory temperature",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "interval": "5s",
      "gridPos": {"h": 8, "w": 8, "x": 0, "y": 8},
      "fieldConfig": {
        "defaults": {"unit": "celsius"},
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "interval": "5s",
          "expr": "hw_temperature_celsius{statistic=\"max\", hw_sensor_location=\"memory\", instance=~\"$host\"}",
          "legendFormat": "{{pci_bdf}}/{{com_intel_subdevice_id}}"
        }
      ]
    },
    {
      "id": 5,
      "title": "Power",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "interval": "5s",
      "gridPos": {"h": 8, "w": 8, "x": 8, "y": 8},
      "fieldConfig": {
        "defaults": {"unit": "watt"},
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "interval": "5s",
          "expr": "hw_power_watts{instance=~\"$host\"}",
          "legendFormat": "{{pci_bdf}}/{{com_intel_subdevice_id}}: {{hw_sensor_location}}"
        }
      ]
    },
    {
      "id": 6,
      "title": "Memory usage",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "interval": "5s",
      "gridPos": {"h": 8, "w": 8, "x": 16, "y": 8},
      "fieldConfig": {
        "defaults": {"unit": "bytes"},
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "interval": "5s",
          "expr": "hw_memory_usage_bytes{instance=~\"$host\"}",
          "legendFormat": "{{pci_bdf}}/{{com_intel_subdevice_id}}"
        }
      ]
    },
    {
      "id": 7,
      "title": "Engine utilization",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "interval": "5s",
      "gridPos": {"h": 8, "w": 24, "x": 0, "y": 16},
      "fieldConfig": {
        "defaults": {"unit": "percentunit"},
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "interval": "5s",
          "expr": "avg by (pci_bdf, com_intel_subdevice_id, hw_gpu_task) (hw_gpu_utilization_ratio{instance=~\"$host\"})",
          "legendFormat": "{{pci_bdf}}/{{com_intel_subdevice_id}}: {{hw_gpu_task}}"
        }
      ]
    }
  ]
}
