diff --git a/src/tts-language.h b/src/tts-language.h
new file mode 100644
index 0000000..8aba12d
--- /dev/null
+++ b/src/tts-language.h
@@ -0,0 +1,41 @@
+#pragma once
+
+#include <fasttext/fasttext.h>
+
+#include <algorithm>
+#include <cctype>
+#include <sstream>
+#include <string>
+#include <vector>
+
+static const char * tts_language(const fasttext::FastText & detector, const std::string & text,
+                                 const std::string & requested) {
+    if (requested.size() != 4 || !std::equal(requested.begin(), requested.end(), "auto",
+            [](unsigned char a, char b) { return std::tolower(a) == b; })) {
+        return requested.c_str();
+    }
+
+    std::stringstream input;
+    for (char c : text) {
+        input.put(c == '\n' || c == '\r' ? ' ' : c);
+    }
+    std::vector<std::pair<fasttext::real, std::string>> predictions;
+    detector.predictLine(input, predictions, 1, 0.5f);
+    if (predictions.empty()) {
+        return "auto";
+    }
+
+    static const struct { const char * label; const char * language; } languages[] = {
+        {"__label__zh", "Chinese"}, {"__label__en", "English"},
+        {"__label__ja", "Japanese"}, {"__label__ko", "Korean"},
+        {"__label__de", "German"}, {"__label__fr", "French"},
+        {"__label__ru", "Russian"}, {"__label__pt", "Portuguese"},
+        {"__label__es", "Spanish"}, {"__label__it", "Italian"},
+    };
+    for (const auto & language : languages) {
+        if (predictions.front().second == language.label) {
+            return language.language;
+        }
+    }
+    return "auto";
+}
